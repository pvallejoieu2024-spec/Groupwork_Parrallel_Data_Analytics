# Python temporary files
__pycache__/
.ipynb_checkpoints/
*.pyc

# macOS temporary files
.DS_Store
__MACOSX/

# Ignore downloaded datasets
data/raw/
data/OSPC_Flight_Data/

# Ignore compressed datasets
data/*.zip

# Keep data download script
!data/.gitkeep

# Ignore generated results
results/*
!results/.gitkeep
!results/*.csv

!results/*/
results/*/*
!results/*/*.csv

# Per-job result folders (results/pool/<JOB_ID>/, results/single_worker/<JOB_ID>/)
!results/*/*/
!results/*/*/*.csv

# Slurm logs (node, CPUs, memory, topology of every run) and plots
!results/*.out
!results/*.png
!results/*/*.png

# Output of the quick test in the README
results/quick_test/
